# Copy to .env and fill in. All optional except the model key for live runs.

# the vendor API key. Needed for the designer, critic and intake vision passes.
# The agent SDK also accepts a logged-in `agent` CLI; then this can stay empty.
AGENT_API_KEY=

# Models by role. Any Agent model id or CLI alias ("opus", "sonnet").
KIN_DESIGNER_MODEL=opus
KIN_CRITIC_MODEL=opus
KIN_VISION_MODEL=opus

# OpenSCAD binary (default: openscad on PATH). Use a Manifold-enabled snapshot for speed if you have one.
KIN_OPENSCAD_BIN=openscad

# Where session workspaces live (default: ./sessions)
KIN_SESSIONS_DIR=./sessions

# Server
KIN_HOST=0.0.0.0
KIN_PORT=8000
