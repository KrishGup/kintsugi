# Copy to .env and fill in. Everything is optional except OPENAI_API_KEY for live runs.
# The web app's Settings dialog writes these same keys (to KIN_ENV_FILE, default <KIN_DATA_DIR>/.env).
# Deploying? docs/DEPLOY-AZURE.md maps every variable to the Azure resource that should carry it.

# ---- model ------------------------------------------------------------------------------------------------------
# OpenAI API key: the designer, the code-blind critic and photo intake all run on the Responses API.
OPENAI_API_KEY=
# Optional: point the OpenAI client somewhere else (Azure OpenAI's OpenAI-compatible endpoint, a gateway, a proxy).
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/

# Provider: openai (default when a key is set) | fake (scripted demo, no key)
KIN_PROVIDER=openai

# Models by role. gpt-6-astra (flagship reasoning, default) | gpt-6-sol (fast, ~5x cheaper) | gpt-6-luna
KIN_DESIGNER_MODEL=gpt-6-astra
KIN_CRITIC_MODEL=gpt-6-astra
KIN_VISION_MODEL=gpt-6-astra
# Reasoning effort for the designer/critic/intake calls: low | medium | high (default) | max
KIN_REASONING_EFFORT=high
# Conversation state: by default each tool step is chained with previous_response_id (store=true) so the blueprint
# images are uploaded once. Set to 1 to resend the full transcript with store=false (zero-retention orgs).
KIN_OPENAI_STATELESS=0
# Per-request timeout and retries for the OpenAI client
KIN_OPENAI_TIMEOUT_S=900
KIN_OPENAI_RETRIES=6

# ---- toolchain --------------------------------------------------------------------------------------------------
# OpenSCAD binary. Unset = `openscad` on PATH, else a portable build in <drive>:\Tools\OpenSCAD beside the checkout,
# else the usual install folders. Setting it skips that search. Point it at a Manifold-enabled snapshot for speed.
# KIN_OPENSCAD_BIN=

# ---- storage ----------------------------------------------------------------------------------------------------
# Everything the app writes goes under KIN_DATA_DIR (default: the current directory). In the container it is /data.
# KIN_DATA_DIR=.
# Session workspaces (default: <KIN_DATA_DIR>/sessions)
# KIN_SESSIONS_DIR=./sessions
# The settings file the web UI writes (default: <KIN_DATA_DIR>/.env)
# KIN_ENV_FILE=./.env
# Keep a git history inside every session folder (1, default). Set 0 on slow network shares (Azure Files) —
# iterations are still recorded in history.json, only the per-file diffs go away.
KIN_SESSION_GIT=1
# Largest session archive the import endpoint accepts, in MB
KIN_MAX_IMPORT_MB=500

# ---- who may use it ---------------------------------------------------------------------------------------------
# none      (default) a personal server: no sign-in, everyone shares the sessions
# token     one shared access code; the UI asks for it once and keeps a signed cookie for 30 days
# easyauth  the platform signs people in (Azure Easy Auth: Microsoft / GitHub / Google); sessions belong to their owner
KIN_AUTH=none
# token mode: the access code (make it long; `openssl rand -hex 24`)
KIN_ACCESS_TOKEN=
# token mode: the cookie signing secret (defaults to the access token; set separately to rotate cookies without the code)
KIN_SECRET_KEY=
# easyauth mode: comma-separated user ids (usually emails, lower-case) who see every session and may change settings
KIN_ADMIN_USERS=
# easyauth mode: which /.auth/login/<provider> the gate links to — aad (Microsoft Entra) | github | google
KIN_EASYAUTH_PROVIDER=aad
# Force the auth cookie's Secure flag (default: on when the request arrived over https, incl. X-Forwarded-Proto)
KIN_COOKIE_SECURE=0
# 1 = the Settings dialog is read-only: provider, key and models come only from the environment (recommended when
# deployed — the key then lives in Key Vault, not in a file on the share)
KIN_SETTINGS_LOCK=0

# ---- guardrails for a shared or public box ----------------------------------------------------------------------
# The most one design run may spend on model calls, in dollars (the client's own token accounting). 0 = no cap.
KIN_MAX_COST_USD=0
# Heavy calls (run, iterate, coupon, export, params, code, photos, intake, import) per client per minute. 0 = off.
KIN_RATE_PER_MIN=0
# OpenSCAD processes at once, whoever asks (previews queue and cancel each other; the rest waits its turn)
KIN_MAX_COMPILES=4

# ---- server -----------------------------------------------------------------------------------------------------
KIN_HOST=0.0.0.0
KIN_PORT=8000
# Trust X-Forwarded-For / X-Forwarded-Proto from the ingress (1, default). Set 0 when exposed directly.
KIN_PROXY_HEADERS=1
# HTTP keep-alive idle timeout (seconds); the event stream is long-lived, keep it above the ingress idle timeout.
KIN_KEEPALIVE_S=75
