# Copy to .env and fill in. Everything is optional except OPENAI_API_KEY for live runs.
# (The web app's Settings dialog writes these same keys.)

# OpenAI API key: the designer, the code-blind critic and photo intake all run on the Responses API.
OPENAI_API_KEY=

# Provider: openai (default when a key is set) | fake (scripted demo, no key) | agent (Agent SDK; pip install ".[agent]")
KIN_PROVIDER=openai

# Models by role. gpt-6-astra (flagship reasoning, default) | gpt-6-sol (fast, ~5x cheaper) | gpt-6-luna
KIN_DESIGNER_MODEL=gpt-6-astra
KIN_CRITIC_MODEL=gpt-6-astra
KIN_VISION_MODEL=gpt-6-astra
# Reasoning effort for the designer/critic/intake calls: low | medium | high (default) | max
KIN_REASONING_EFFORT=high
# Conversation state: by default each tool step is chained with previous_response_id (store=true) so the blueprint
# images are uploaded once. Set to 1 to resend the full transcript with store=false (zero-retention orgs).
KIN_OPENAI_STATELESS=0
# Per-request timeout and retries for the OpenAI client
KIN_OPENAI_TIMEOUT_S=900
KIN_OPENAI_RETRIES=6

# OpenSCAD binary (default: openscad on PATH). Use a Manifold-enabled snapshot for speed if you have one.
KIN_OPENSCAD_BIN=openscad

# Where session workspaces live (default: ./sessions)
KIN_SESSIONS_DIR=./sessions

# Server
KIN_HOST=0.0.0.0
KIN_PORT=8000
