    },
    "interfaces": {
      "items": {
        "$ref": "#/$defs/Interface"
      },
      "title": "Interfaces",
      "type": "array"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "context": {
