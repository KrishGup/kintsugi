          "type": "string"
        },
        "object": {
          "default": "",
          "title": "Object",
          "type": "string"
        },
        "design_intent": {
          "default": "",
          "title": "Design Intent",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
