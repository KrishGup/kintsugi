      "title": "Open Questions",
      "type": "array"
    }
  },
  "title": "Kintsugi Part Spec (spec.yaml)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kintsugi.dev/schemas/part-spec.schema.json",
  "description": "The contract between the person, the designer and the checker: the part, its interfaces (mating features with dimensions, estimates and measure recipes), requirements, context proxies, print settings."
}
